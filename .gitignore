# =========================
# LONTAR AIEL - .gitignore
# =========================

# -------------------------
# 1. SECURITY & CREDENTIALS
# -------------------------
# Never commit environment variables, keys, or tokens
.env
.env.*
*.env
confluent.env
confluent.env.example
*.pem
*.key
credentials.json
*secret*
api-key*.txt
*ready_stream*

# -------------------------
# 2. PRIVACY & TELEMETRY
# -------------------------
# Zero-Prompt Retention Guarantee - never commit raw telemetry or user identity
identity.json
.lontar/
*.jsonl
transcript.jsonl
transcript_full.jsonl
*.log
local_state/
telemetry_cache/

# -------------------------
# 3. PRIVATE DOCUMENTS & JOBS
# -------------------------
# Private internal design, roadmaps, and deployed streaming jobs
docs/PRD.md
docs/ROADMAP.md
docs/PROJECT_SCOPE.md
docs/IMPLEMENTATION_PLAN.md
config/flink-jobs/

# -------------------------
# 4. ELIXIR & BEAM
# -------------------------
# Software efficiency - ignore build artifacts and dependencies
_build/
deps/
*.ez
*.beam
erl_crash.dump

# -------------------------
# 5. OS & IDE
# -------------------------
.DS_Store
Thumbs.db
*.tmp
.vscode/
.idea/
*.swp

# -------------------------
# 6. DATA & LOCAL SCRATCH
# -------------------------
data/
scratch/
*.tgz
*.tar.gz
*.tar
