# =========================
# LONTAR AIEL - .gitignore
# =========================

# -------------------------
# 1. SECURITY & CREDENTIALS
# -------------------------
# Never commit environment variables, keys, or tokens
.env
.env.*
*.env
confluent.env
*.pem
*.key
credentials.json
*secret*

# -------------------------
# 2. PRIVACY & TELEMETRY
# -------------------------
# Zero-Prompt Retention Guarantee - never commit raw telemetry or user identity
identity.json
.lontar/
*.jsonl
transcript.jsonl
transcript_full.jsonl
*.log
local_state/
telemetry_cache/

# -------------------------
# 3. ELIXIR & BEAM
# -------------------------
# Software efficiency - ignore build artifacts and dependencies
_build/
deps/
*.ez
*.beam
erl_crash.dump

# -------------------------
# 4. OS & IDE
# -------------------------
.DS_Store
Thumbs.db
*.tmp
.vscode/
.idea/
*.swp

# -------------------------
# 5. DATA & LOCAL SCRATCH
# -------------------------
data/
scratch/
