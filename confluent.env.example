# ==============================================================================
# 📜 Lontar AIEL: Confluent Cloud & Server Environment Configuration
# ==============================================================================
# Version Tag: v0.1.0-confluent.2026-09-22-19:00
# Copy this file to ~/.gemini/lontar_confluent.env or .env in your lontar-aiel directory

# ------------------------------------------------------------------------------
# 1. Confluent Cloud Cluster & REST Proxy Configuration
# ------------------------------------------------------------------------------
CONFLUENT_BOOTSTRAP_SERVER=pkc-xxxx.us-east-2.aws.confluent.cloud:9092
CONFLUENT_REST_ENDPOINT=https://pkc-xxxx.us-east-2.aws.confluent.cloud:443
CONFLUENT_TOPIC=ai.inference.raw-events
CONFLUENT_API_KEY=YOUR_CONFLUENT_CLUSTER_API_KEY
CONFLUENT_API_SECRET=YOUR_CONFLUENT_CLUSTER_API_SECRET

# ------------------------------------------------------------------------------
# 2. Confluent Schema Registry Configuration
# ------------------------------------------------------------------------------
CONFLUENT_SCHEMA_REGISTRY_URL=https://psrc-xxxx.us-east-2.aws.confluent.cloud
CONFLUENT_SR_API_KEY=YOUR_SCHEMA_REGISTRY_API_KEY
CONFLUENT_SR_API_SECRET=YOUR_SCHEMA_REGISTRY_API_SECRET

# ------------------------------------------------------------------------------
# 3. OpenTelemetry Collector Server Configuration
# ------------------------------------------------------------------------------
OTEL_COLLECTOR_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic BASE64_ENCODED_KEY_SECRET

# ------------------------------------------------------------------------------
# 4. Local Edge Device Daemon Options
# ------------------------------------------------------------------------------
LONTAR_TELEMETRY_ENABLED=true
# Optional Device Identifier Override (e.g. windows-desktop, termux-node)
# LONTAR_DEVICE=windows
# Optional Datacenter Region (e.g. global-avg, us-east-1, europe-west9)
# LONTAR_REGION=global-avg
