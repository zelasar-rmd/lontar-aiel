# ==============================================================================
# 📜 Lontar AIEL: Confluent Cloud Trial Environment Configuration
# ==============================================================================
# Copy this file to ~/.gemini/lontar_confluent.env or .env in your lontar-aiel directory
# Fill in your Confluent Cloud Trial credentials below.

# Confluent Cloud Cluster REST Proxy Endpoint (e.g. https://pkc-xxxx.us-east-2.aws.confluent.cloud:443)
CONFLUENT_REST_ENDPOINT=https://your-confluent-cluster-endpoint.confluent.cloud

# Confluent Cloud Topic Name for Telemetry Events
CONFLUENT_TOPIC=ai.emission.telemetry.v1

# Confluent Cloud API Key (Cluster API Key)
CONFLUENT_API_KEY=YOUR_CONFLUENT_API_KEY

# Confluent Cloud API Secret (Cluster API Secret)
CONFLUENT_API_SECRET=YOUR_CONFLUENT_API_SECRET

# Enable background real-time telemetry streaming (true/false)
LONTAR_TELEMETRY_ENABLED=true

# Optional Device Identifier Override (e.g. work-laptop, dev-termux)
# LONTAR_DEVICE=windows
