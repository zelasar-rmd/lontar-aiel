#!/data/data/com.termux/files/usr/bin/env bash
# Lontar AIEL gateway exposure — Cloudflare quick tunnel (start|stop|status|url|restart)
set -euo pipefail

PORT="${INGEST_PORT:-8787}"
PID_FILE="$HOME/.gemini/lontar_tunnel.pid"
LOG_FILE="$HOME/.gemini/lontar_tunnel.log"

mkdir -p "$(dirname "$PID_FILE")"

is_running() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE" 2>/dev/null)" 2>/dev/null
}

public_url() {
  grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' "$LOG_FILE" 2>/dev/null | head -1
}

start() {
  if is_running; then
    echo "tunnel already running (pid $(cat "$PID_FILE")); url: $(public_url)"
    return 0
  fi

  if ! command -v cloudflared >/dev/null 2>&1; then
    echo "cloudflared not found — run: pkg install -y cloudflared" >&2
    return 1
  fi

  nohup cloudflared tunnel --url "http://127.0.0.1:$PORT" --no-autoupdate > "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"
  echo "tunnel starting (pid $(cat "$PID_FILE")); public URL (may take ~5s):"
  echo "  $(public_url)"
}

stop() {
  if is_running; then
    kill "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo "tunnel stopped."
  else
    rm -f "$PID_FILE"
    echo "tunnel not running."
  fi
}

status() {
  if is_running; then
    echo "RUNNING (pid $(cat "$PID_FILE"))"
    echo "  url: $(public_url)"
  else
    echo "STOPPED"
  fi
}

case "${1:-status}" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  status) status ;;
  url) public_url ;;
  *) echo "usage: $0 start|stop|status|url|restart"; exit 1 ;;
esac
