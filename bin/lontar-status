#!/data/data/com.termux/files/usr/bin/sh
echo "=== 🌿 LONTAR AIEL STATUS ==="

CRON_LIST=$(/data/data/com.termux/files/usr/bin/crontab -l 2>/dev/null)

if [ -z "$CRON_LIST" ] && [ -f /data/data/com.termux/files/usr/var/spool/cron/root ]; then
  CRON_LIST=$(cat /data/data/com.termux/files/usr/var/spool/cron/root)
fi

if [ -z "$CRON_LIST" ]; then
  CRON_LIST=$(crontab -l 2>/dev/null)
fi

if [ -n "$CRON_LIST" ]; then
  LONTAR_CRON=$(echo "$CRON_LIST" | grep -i "lontar")
  if [ -n "$LONTAR_CRON" ]; then
    echo "$LONTAR_CRON"
  else
    echo "❌ No active Lontar AIEL crontab scheduled"
  fi
else
  echo "❌ No active crontab scheduled"
fi

if pgrep crond >/dev/null 2>&1 || pgrep cron >/dev/null 2>&1; then
  echo "✅ Background cron daemon (crond) is active"
else
  echo "⚠️ Background cron daemon (crond) is not running"
fi

USER_HOME="${HOME:-/data/data/com.termux/files/home}"
PID_FILE="$USER_HOME/.gemini/lontar_daemon.pid"
if [ ! -f "$PID_FILE" ]; then
  PID_FILE="/root/.gemini/lontar_daemon.pid"
fi

if [ -f "$PID_FILE" ]; then
  DAEMON_PID=$(cat "$PID_FILE" 2>/dev/null | tr -d '[:space:]')
  if [ -n "$DAEMON_PID" ] && kill -0 "$DAEMON_PID" 2>/dev/null; then
    echo "✅ Real-time telemetry stream daemon is RUNNING (PID: $DAEMON_PID)"
  else
    echo "ℹ️ Real-time telemetry stream daemon is STOPPED"
  fi
else
  echo "ℹ️ Real-time telemetry stream daemon is STOPPED"
fi

LOG_FILE="$USER_HOME/.gemini/lontar_daemon.log"
if [ -f "$LOG_FILE" ]; then
  echo "   --- Recent Activity ---"
  tail -n 8 "$LOG_FILE" | while read -r line; do
    echo "   $line"
  done
fi